{
  "name": "biznation-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo para prueba técnica Biz Nation (Express + TypeScript + Sequelize + PostgreSQL + Angular)",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=26.13.1",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "dev:backend": "pnpm --filter @biznation/backend dev",
    "dev:frontend": "pnpm --filter @biznation/frontend start",
    "build": "pnpm -r build",
    "build:backend": "pnpm --filter @biznation/backend build",
    "build:frontend": "pnpm --filter @biznation/frontend build",
    "test": "pnpm -r test",
    "test:backend": "pnpm --filter @biznation/backend test",
    "test:frontend": "pnpm --filter @biznation/frontend test",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @biznation/backend db:migrate",
    "db:seed": "pnpm --filter @biznation/backend db:seed"
  }
}
